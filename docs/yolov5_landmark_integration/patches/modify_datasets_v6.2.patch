+    def load_labels(self, path):
+        """
+        Support two formats per line:
+          1) class x y w h
+          2) class x y w h lmk0_x lmk0_y ... lmk3_x lmk3_y  (total 1+4+8=13 values)
+        Landmarks are expected normalized to [0,1] relative to original image width/height.
+        Missing landmarks will be filled with -1 and a mask should be generated later.
+        """
+        labels = []
+        with open(path, 'r') as f:
+            for line in f.readlines():
+                vals = line.strip().split()
+                if not vals:
+                    continue
+                cls = int(vals[0])
+                if len(vals) < 5:
+                    continue
+                x = float(vals[1]); y = float(vals[2]); w = float(vals[3]); h = float(vals[4])
+                landms = []
+                if len(vals) >= 13:
+                    # parse 8 landmark values (4 points)
+                    for v in vals[5:13]:
+                        landms.append(float(v))
+                else:
+                    # pad with -1 indicating missing landmarks
+                    landms = [-1.0] * 8
+                labels.append([cls, x, y, w, h] + landms)
+        return labels
