+class Detect(nn.Module):
+    stride = None  # strides computed during build
+    onnx_dynamic = False  # ONNX export parameter
+
+    def __init__(self, nc=80, anchors=(), ch=(), num_landmarks=0, inplace=True):  # detection layer
+        """
+        nc: number of classes
+        num_landmarks: number of landmark points (each point has x+y => 2 dims). For 4 points => num_landmarks=4 => 8 dims
+        Default num_landmarks=0 means no landmark prediction (backward compatible).
+        """
+        super().__init__()
+        self.nc = nc
+        self.num_landmarks = max(0, int(num_landmarks))
+        # outputs per anchor: 5 (xywh + obj) + 2*num_landmarks + nc
+        self.no = 5 + (2 * self.num_landmarks if self.num_landmarks > 0 else 0) + self.nc
+        self.nl = len(anchors)  # number of detection layers
+        self.na = len(anchors[0]) // 2  # number of anchors
+        self.grid = [torch.zeros(1)] * self.nl
+        self.anchor_grid = [torch.zeros(1)] * self.nl
+        self.register_buffer('anchors', torch.tensor(anchors).float().view(self.nl, -1, 2))
+        # initialize conv outputs using self.no
+        self.m = nn.ModuleList(nn.Conv2d(x, self.no * self.na, 1) for x in ch)
+        self.inplace = inplace
